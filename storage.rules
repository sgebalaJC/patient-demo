rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Sync: web/src/lib/roles.ts, functions/src/superAdmins.ts, firestore.rules
    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'stanislaw.gebala@gmail.com';
    }

    function isAdmin() {
      return isSuperAdmin() || (request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Shared content-type allowlist for any upload that lands in a path an
    // admin (or another patient) might later open via signed URL. Without it,
    // a patient can upload `evil.html` to chat-attachments / message
    // attachments and serve it from the firebasestorage.googleapis.com origin
    // — phishing / drive-by surface against admins. Same shape we already
    // enforce on patient documents.
    function uploadContentTypeOk() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || request.resource.contentType == 'text/plain';
    }

    // Patient documents — owner can read/write, admins can read.
    // Writes capped at 25 MB with a content-type allowlist so a patient can't
    // host arbitrary binaries or DoS storage cost via this path.
    match /patients/{patientId}/documents/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == patientId;
      allow read: if isAdmin();
      allow write: if request.auth != null
        && request.auth.uid == patientId
        && request.resource.size < 25 * 1024 * 1024
        && uploadContentTypeOk();
    }

    // Message attachments — only thread participants (patient or admin) can access
    match /messages/{threadId}/attachments/{allPaths=**} {
      allow read: if request.auth != null && (
        firestore.get(/databases/(default)/documents/message-threads/$(threadId)).data.patientId == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && uploadContentTypeOk()
        && (
          firestore.get(/databases/(default)/documents/message-threads/$(threadId)).data.patientId == request.auth.uid ||
          isAdmin()
        );
      allow delete: if isAdmin();
    }

    // Chat attachments (admin agent + patient support). Path:
    //   chat-attachments/{senderId}/{attachmentId}/{fileName}
    // Owner uploads + reads their own; admins read any (for moderation /
    // troubleshooting). Hard delete by owner or admin.
    match /chat-attachments/{senderId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == senderId || isAdmin()
      );
      allow create: if request.auth != null
        && request.auth.uid == senderId
        && request.resource.size < 25 * 1024 * 1024
        && uploadContentTypeOk();
      allow delete: if request.auth != null && (
        request.auth.uid == senderId || isAdmin()
      );
    }

    // Export archives — only accessible via signed URLs from Cloud Function
    match /exports/{patientId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Prior-auth raw policy snapshots — admin read only; Cloud Functions +
    // extraction scripts write via Admin SDK (bypasses rules).
    match /pa-snapshots/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Prior-auth supporting documents (chart excerpts, prior imaging). Admin-only.
    match /pa-attachments/{paId}/{allPaths=**} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Inbound fax PDFs — written by SignalWire webhook via Admin SDK, read
    // by admin UI + Aurelia extraction on the sidecar.
    match /incoming-faxes/{faxSid}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Outbound fax staging — admin uploads PDFs before submitting; Cloud
    // Function reads during sendOutboundFax and writes the merged file.
    match /admin/outbound-faxes/{batchId}/{allPaths=**} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.size < 20 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Simulation sandbox PDFs (sim mode only) — seeded by Cloud Function,
    // read by admin UI via signed URL. Writes always server-only.
    match /simulation/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
