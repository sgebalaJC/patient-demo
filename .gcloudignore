# Files ignored by gcloud / Cloud Build when uploading the build context.
# Keeps the App Hosting upload lean and speeds up change detection.
#
# App Hosting only needs the `web/` workspace + apphosting.yaml. Everything
# else in this monorepo (mobile/, functions/, sidecar/, openclaw/) is built
# and deployed separately.

# Non-web workspaces
mobile/
functions/
sidecar/
openclaw/
dataconnect/

# Repo-level tooling/docs
docs/
scripts/
.github/
*.md

# Firestore/Storage configs (deployed via `firebase deploy`, not App Hosting)
firestore.rules
firestore.indexes.json
storage.rules
.firebaserc
firebase.json

# Local dev caches
.vscode/
.idea/
.DS_Store

# Anything already git-ignored
.gcloudignore
#!include:.gitignore
