{
  "name": "YOUR_FIREBASE_PROJECT-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.html",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "serve -s dist",
    "emulators:export-and-stop": "cd .. && (firebase emulators:export . 2>/dev/null || true) && sleep 2 && pkill -f firebase || true",
    "emulators": "npm run emulators:export-and-stop && sleep 1 && cd .. && firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "emulators:stop": "pkill -f firebase || true",
    "emulators:fresh": "cd .. && rm -rf ./emulator-data && firebase emulators:start --export-on-exit=./emulator-data",
    "emulators:export": "cd .. && firebase emulators:export ./emulator-data",
    "emulators:import": "cd .. && firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "emulators:clean": "cd .. && rm -rf ./emulator-data && firebase emulators:start --export-on-exit=./emulator-data"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.10",
    "@hookform/resolvers": "^3.3.2",
    "clsx": "^2.1.1",
    "firebase": "^10.13.2",
    "lucide-react": "^0.577.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.16.0",
    "remark-gfm": "^4.0.1",
    "serve": "^14.2.6",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.15",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}
