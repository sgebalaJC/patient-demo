rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user owns the resource
    function isOwner(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }

    // Users collection.
    //
    // Self-update is field-restricted so a patient cannot self-promote to admin:
    // `isAdmin()` reads `role` from this very doc, so without a field gate a
    // patient writing `{role:'admin'}` to their own doc collapses the entire
    // RBAC model. `affectedKeys().hasOnly([...])` rejects any write that
    // touches `role`, `isActive`, `permissions`, `stripeCustomerId`, etc.
    //
    // On first sign-in the auth helper creates the doc with `role:'patient'`
    // and `isActive:false` — the `create` rule pins those values so a fresh
    // signup cannot bootstrap itself as admin either.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow delete: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.role == 'patient'
        && request.resource.data.isActive == false;
      allow create: if isAdmin();

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'displayName', 'dateOfBirth', 'gender',
          'phoneNumber', 'email', 'emailVerified', 'phoneVerified',
          'address', 'emergencyContact', 'insuranceInfo',
          'allergies', 'medicalHistory',
          'fcmToken', 'fcmTokenUpdatedAt',
          'lastLoginAt', 'updatedAt', 'createdAt',
          'tutorialCompletedSections', 'tutorialSkippedSections',
          'tutorialDismissedAt', 'intakeFormSkipped'
        ]);
      allow update: if isAdmin();
    }

    // Message threads — patient owns their threads, admins access all
    match /message-threads/{threadId} {
      allow read, list, write: if request.auth != null && (
        isOwner(resource.data.patientId) || isAdmin()
      );
      allow create: if request.auth != null && (
        isOwner(request.resource.data.patientId) || isAdmin()
      );
    }

    // Thread messages — access via parent thread ownership or admin
    match /thread-messages/{messageId} {
      function hasThreadAccess() {
        let thread = get(/databases/$(database)/documents/message-threads/$(resource.data.threadId));
        return isOwner(thread.data.patientId) || isAdmin();
      }

      allow read, list, write: if request.auth != null && hasThreadAccess();
      allow create: if request.auth != null && (
        isOwner(request.resource.data.senderId) || isAdmin()
      );
    }

    // Appointments.
    //
    // Patients can create, read, delete, and update their own — but may only
    // transition status to `cancelled` (or leave it unchanged, e.g. when
    // rescheduling). Transitions to `confirmed`/`completed`/`no-show` are
    // admin-only because `onAppointmentWrite` auto-creates a Google Calendar
    // event and sends a confirmation SMS on `scheduled → confirmed`. Without
    // this gate, a patient could self-approve by flipping their own status.
    match /appointments/{appointmentId} {
      allow read, list: if isAdmin();
      allow read, delete: if isOwner(resource.data.patientId) || isAdmin();
      allow create: if isOwner(request.resource.data.patientId) || isAdmin();
      allow update: if isAdmin();
      allow update: if isOwner(resource.data.patientId) && (
        request.resource.data.status == resource.data.status ||
        request.resource.data.status == 'cancelled' ||
        request.resource.data.status == 'scheduled'
      );
    }

    // Specialist requests — patients may cancel, admins manage approval flow.
    match /specialist-requests/{requestId} {
      allow read, delete: if isOwner(resource.data.patientId) || isAdmin();
      allow create: if isOwner(request.resource.data.patientId) || isAdmin();
      allow update: if isAdmin();
      allow update: if isOwner(resource.data.patientId) && (
        request.resource.data.status == resource.data.status ||
        request.resource.data.status == 'cancelled'
      );
    }

    // Prescription refills — patients submit, admins approve/deny/complete.
    // Patients must not be able to self-approve, so status transitions
    // (other than cancel) are admin-only.
    match /prescription-refills/{refillId} {
      allow read, delete: if isOwner(resource.data.patientId);
      allow create: if isOwner(request.resource.data.patientId);
      allow update: if isOwner(resource.data.patientId) && (
        request.resource.data.status == resource.data.status ||
        request.resource.data.status == 'cancelled'
      );
      allow read, write: if isAdmin();
    }

    // Patient documents
    match /patient-documents/{documentId} {
      allow read, write: if isOwner(resource.data.patientId) || isAdmin();
      allow create: if isOwner(request.resource.data.patientId) || isAdmin();
    }

    // Patient intake forms
    match /patient-intake-forms/{formId} {
      allow read, write: if isOwner(resource.data.patientId) || isAdmin();
      allow create: if isOwner(request.resource.data.patientId) || isAdmin();
    }

    // Notifications — admins full access, patients only see/update their own.
    //
    // The list rule must reference `resource.data.recipientId` so Firestore
    // rejects any candidate doc where the recipient doesn't match. Without
    // that check, any signed-in patient could enumerate every notification
    // in the system (they carry PHI: appointment times, refill meds, etc.).
    // Clients must query with `where('recipientId','==', uid)`.
    match /notifications/{notificationId} {
      allow read, list, write: if isAdmin();
      allow create: if request.auth != null && (
        request.resource.data.recipientRole == 'admin' ||
        request.resource.data.recipientId == request.auth.uid
      );
      allow get, update: if request.auth != null &&
        resource.data.recipientId == request.auth.uid;
      allow list: if request.auth != null &&
        resource.data.recipientId == request.auth.uid;
    }

    // Agent skills — admin only
    match /agent-skills/{skillId} {
      allow read, list, write: if isAdmin();
    }

    // Agent chat messages — admin only. Any admin can hard-delete (curate).
    match /agent-chat/{messageId} {
      allow read, list, create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Support chat messages — patients can read/create/delete their own,
    // admins can read + delete any. Updates are still locked.
    match /support-chat/{messageId} {
      allow create: if request.auth != null
        && request.resource.data.patientId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.patientId == request.auth.uid || isAdmin()
      );
      allow list: if request.auth != null && (
        resource.data.patientId == request.auth.uid || isAdmin()
      );
      allow delete: if request.auth != null && (
        resource.data.patientId == request.auth.uid || isAdmin()
      );
    }

    // Phone verifications — server-side only (Cloud Functions)
    match /phone-verifications/{docId} {
      allow read, write: if false;
    }

    // Phone login codes — server-side only (Cloud Functions)
    match /phone-login-codes/{docId} {
      allow read, write: if false;
    }

    // System config — admin can read/write templates, rest server-only.
    // Exception: `system/settings` is publicly readable so the unauthenticated
    // /auth page can check `registrationEnabled` and `bootstrapped` before
    // showing signup or the bootstrap-first-admin form. Writes still admin-only.
    match /system/settings {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /system/{docId} {
      allow read, write: if isAdmin();
    }

    // Bootstrap-first-admin request channel.
    //
    // Unauthenticated clients write a request doc on fresh installs; the
    // `onBootstrapRequestCreated` Firestore trigger (running as the function's
    // service account) processes it and writes the custom token back.
    //
    // Security model:
    //  - `create` is allowed only when `system/settings.bootstrapped` is false
    //    or missing. Once the flag flips, no new requests are accepted.
    //  - `get` is allowed on any doc (to read the token after the trigger
    //    completes) but `list` is denied — the doc ID is a client-generated
    //    UUID with 128 bits of entropy, so an attacker can't enumerate to
    //    steal tokens.
    //  - `update` is denied from clients. Only the trigger (via Admin SDK,
    //    which bypasses rules) can update status/token.
    //  - `delete` is allowed so the client can clean up its own request
    //    after successful sign-in.
    match /bootstrap-requests/{requestId} {
      allow create: if
        !exists(/databases/$(database)/documents/system/settings) ||
        get(/databases/$(database)/documents/system/settings).data.bootstrapped != true;
      allow get, delete: if true;
      allow list, update: if false;
    }

    // Integrations — admin-only read and delete. Create/update is
    // server-only (Cloud Functions write via Admin SDK, bypasses rules).
    match /integrations/{integrationId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // Rate limits — server-side only (Cloud Functions)
    match /rate-limits/{docId} {
      allow read, write: if false;
    }

    // Subscription plans — admins manage, all signed-in users can read
    match /subscription-plans/{priceId} {
      allow read, list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Patient subscriptions — mirror of Stripe state, written only by the
    // stripeWebhook Cloud Function. Patients read their own, admins read all.
    match /patient-subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false; // server-only
    }

    // Platform subscription — the practice pays the platform vendor for the
    // right to run the portal. Mirror of Stripe state written only by the
    // platformStripeWebhook Cloud Function. Admin-read, server-write-only.
    // Docs inside `platform/`:
    //   - `subscription` (singleton: plan, status, stripeCustomerId, period, lapsedAt)
    //   - `config` (singleton: monthly allowance, economy model, warning threshold)
    //   - `bonus` (singleton: remaining top-up tokens)
    //   - `usage-{YYYY-MM}` (one per month: aggregated token counts)
    match /platform/{docId} {
      allow read, list: if isAdmin();
      allow create, update, delete: if false; // server-only
    }

    // Platform top-up ledger — one doc per $25 top-up purchase.
    match /platform-topups/{topupId} {
      allow read, list: if isAdmin();
      allow create, update, delete: if false; // server-only
    }

    // Platform Stripe webhook idempotency guard (one doc per processed event).
    match /platform-stripe-events/{eventId} {
      allow read, list: if isAdmin();
      allow create, update, delete: if false; // server-only
    }
  }
}
