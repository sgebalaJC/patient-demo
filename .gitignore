# --- Firebase platform configs (auto-generated by flutterfire configure) ---
# These contain per-project API keys. For the template repo, we ignore them
# and ship `.template` placeholder siblings. For customer forks, each fork
# commits its own real versions to its own private repo.
#
# Note: `mobile/lib/firebase_options.dart` is NOT ignored — it's tracked as a
# placeholder so `flutter build` works on fresh clones. After running
# `flutterfire configure`, it will be overwritten with real values; commit the
# overwrite to your customer fork but never back to the template.
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist

# Service account keys (downloaded from Firebase → Service accounts)
# Used by seed scripts, backups, migrations. NEVER commit.
scripts/sa-key*.json
scripts/*-service-account*.json
*-sa-key.json
gcp-key.json

# Other credentials
*.pem
*.p12
*.key
!**/android/**/*.key
.gcloud/

