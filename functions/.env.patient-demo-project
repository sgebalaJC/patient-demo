# Per-project env vars for the demo fork's Cloud Functions.
#
# Firebase CLI auto-loads `functions/.env.<project-id>` only when deploying
# to that project, so installer-emitted customer forks (different project
# id) never pick up the simulation flag — sim chrome stays out of real
# practice deployments.
#
# Mirrors web/apphosting.yaml's INCLUDE_SIM_MODE for the demo build.

INCLUDE_SIM_MODE=true
