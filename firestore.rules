rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── Helpers ─────────────────────────

    // Super admin identified by email — no Firestore user doc needed.
    // Sync: web/src/lib/roles.ts, functions/src/superAdmins.ts, storage.rules
    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'stanislaw.gebala@gmail.com';
    }

    // Admin is resolved from the users doc itself, so the users/{uid} rule
    // MUST gate writes to `role` — see `userSelfUpdateIsSafe()`.
    function isAdmin() {
      return isSuperAdmin() || (request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isOwner(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }

    // Allowlist of fields a user may mutate on their own profile.
    //
    // Kept as an allowlist (not a blocklist) so a new sensitive field added
    // later is denied by default rather than accidentally client-writable.
    // `role`, `isActive`, `permissions`, `customClaims`, `stripeCustomerId`,
    // etc. are deliberately absent — `isAdmin()` reads `role` from this very
    // doc, so client-writable role would collapse RBAC.
    function userSelfUpdateIsSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'firstName', 'lastName', 'displayName', 'dateOfBirth', 'gender',
        'phoneNumber', 'email', 'emailVerified', 'phoneVerified',
        'address', 'emergencyContact', 'insuranceInfo',
        'allergies', 'medicalHistory',
        'fcmToken', 'fcmTokenUpdatedAt',
        'lastLoginAt', 'updatedAt', 'createdAt',
        'tutorialCompletedSections', 'tutorialSkippedSections',
        'tutorialDismissedAt', 'intakeFormSkipped'
      ]);
    }

    // A patient-driven update to an owned record is safe if it:
    //  (a) does NOT reassign ownership (`patientId` pinned), and
    //  (b) either leaves status unchanged OR moves it to an allowed value.
    //
    // Side-effect-bearing transitions (`confirmed` triggers SMS + Calendar,
    // `approved` passes the intake-review gate, etc.) are admin-only — those
    // values must not appear in the allowlist passed here.
    function patientStatusSafe(allowedStatuses) {
      return request.resource.data.patientId == resource.data.patientId &&
        (request.resource.data.status == resource.data.status ||
         request.resource.data.status in allowedStatuses);
    }

    // ───────────────────────── Users ─────────────────────────

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list, delete: if isAdmin();

      // First-sign-in self-create: must claim patient role and be inactive.
      // Admin creates happen via the admin SDK in Cloud Functions anyway,
      // but we keep an admin branch so emulator tests mirror prod.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == 'patient' &&
        request.resource.data.isActive == false
      );

      allow update: if isAdmin() || (isOwner(userId) && userSelfUpdateIsSafe());
    }

    // ───────────────────────── Messaging ─────────────────────────

    match /message-threads/{threadId} {
      allow read, list, write: if request.auth != null && (
        isOwner(resource.data.patientId) || isAdmin()
      );
      allow create: if request.auth != null && (
        isOwner(request.resource.data.patientId) || isAdmin()
      );
    }

    match /thread-messages/{messageId} {
      function hasThreadAccess() {
        let thread = get(/databases/$(database)/documents/message-threads/$(resource.data.threadId));
        return isOwner(thread.data.patientId) || isAdmin();
      }

      allow read, list, write: if request.auth != null && hasThreadAccess();
      allow create: if request.auth != null && (
        isOwner(request.resource.data.senderId) || isAdmin()
      );
    }

    // ───────────────── Status-bearing patient records ─────────────────
    //
    // Same shape for all four: admin full access, patient can create + read +
    // delete + cancel their own. The `patientStatusSafe` helper pins the
    // patientId (no ownership-flip) and caps client-writable statuses.

    match /appointments/{appointmentId} {
      allow read, list, write: if isAdmin();
      allow read, delete: if isOwner(resource.data.patientId);
      allow create: if isOwner(request.resource.data.patientId);
      // `scheduled` is included so reschedule can re-set the status when
      // the patient changes date/time on a previously-scheduled slot.
      allow update: if isOwner(resource.data.patientId)
        && patientStatusSafe(['cancelled', 'scheduled']);
    }

    match /specialist-requests/{requestId} {
      allow read, list, write: if isAdmin();
      allow read, delete: if isOwner(resource.data.patientId);
      allow create: if isOwner(request.resource.data.patientId);
      allow update: if isOwner(resource.data.patientId)
        && patientStatusSafe(['cancelled']);
    }

    match /prescription-refills/{refillId} {
      allow read, list, write: if isAdmin();
      allow read, delete: if isOwner(resource.data.patientId);
      allow create: if isOwner(request.resource.data.patientId);
      allow update: if isOwner(resource.data.patientId)
        && patientStatusSafe(['cancelled']);
    }

    // Intake forms — patient may drive draft → in_progress → completed but
    // cannot flip to `approved`/`sent_back` (admin review gate) and cannot
    // forge reviewer metadata. Admin uses `approveIntakeForm` /
    // `sendBackIntakeForm` which run against the admin branch below.
    match /patient-intake-forms/{formId} {
      allow read, list, write: if isAdmin();
      allow read, delete: if isOwner(resource.data.patientId);
      allow create: if isOwner(request.resource.data.patientId);
      allow update: if isOwner(resource.data.patientId)
        && patientStatusSafe(['draft', 'in_progress', 'completed'])
        && request.resource.data.reviewedBy == resource.data.reviewedBy
        && request.resource.data.reviewNotes == resource.data.reviewNotes
        && request.resource.data.approvedAt == resource.data.approvedAt;
    }

    // ───────────────────────── Patient documents ─────────────────────────

    match /patient-documents/{documentId} {
      allow read, write: if isOwner(resource.data.patientId) || isAdmin();
      allow create: if isOwner(request.resource.data.patientId) || isAdmin();
    }

    // ───────────────────────── Notifications ─────────────────────────
    //
    // List rule MUST reference `resource.data.recipientId` — Firestore
    // otherwise returns the whole collection on an unfiltered list query,
    // leaking PHI-bearing admin notifications to any authenticated patient.
    // Clients must pass `where('recipientId','==', uid)` for list to match.
    match /notifications/{notificationId} {
      allow read, list, write: if isAdmin();
      allow create: if request.auth != null && (
        request.resource.data.recipientRole == 'admin' ||
        request.resource.data.recipientId == request.auth.uid
      );
      allow get, update, list: if request.auth != null &&
        resource.data.recipientId == request.auth.uid;
    }

    // ───────────────────────── Admin-only collections ─────────────────────────

    match /agent-skills/{skillId} {
      allow read, list, write: if isAdmin();
    }

    match /agent-chat/{messageId} {
      allow read, list, create, delete: if isAdmin();
    }

    // ───────────────────────── Support chat ─────────────────────────

    match /support-chat/{messageId} {
      allow create: if request.auth != null
        && request.resource.data.patientId == request.auth.uid;
      allow read, list, delete: if request.auth != null && (
        resource.data.patientId == request.auth.uid || isAdmin()
      );
    }

    // ───────────────────────── Client error telemetry ─────────────────────────
    //
    // Written only by the `logClientError` Cloud Function (Admin SDK bypasses
    // rules). Admins read for the /admin/client-errors feed; admins may also
    // delete to curate. No client write path.
    match /client-errors/{errorId} {
      allow read, list, delete: if isAdmin();
      allow create, update: if false;
    }

    // ───────────────────────── Server-only collections ─────────────────────────

    match /phone-verifications/{docId}   { allow read, write: if false; }
    match /phone-login-codes/{docId}     { allow read, write: if false; }
    match /rate-limits/{docId}           { allow read, write: if false; }

    // System config — admin manages templates. `system/settings` is public
    // so the unauthenticated /auth page can check `registrationEnabled` and
    // `bootstrapped` before rendering signup or the bootstrap-admin form.
    match /system/settings {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /system/{docId} {
      allow read, write: if isAdmin();
    }

    // Bootstrap-first-admin channel (WordPress-style): unauthenticated
    // clients submit a request when `system/settings.bootstrapped !== true`;
    // the `onBootstrapRequestCreated` trigger (Admin SDK) writes the custom
    // token back. Doc IDs are 128-bit UUIDs, `list` is denied, and `update`
    // is trigger-only so clients can't steal or forge tokens.
    match /bootstrap-requests/{requestId} {
      allow create: if
        !exists(/databases/$(database)/documents/system/settings) ||
        get(/databases/$(database)/documents/system/settings).data.bootstrapped != true;
      allow get, delete: if true;
      allow list, update: if false;
    }

    // Integrations — admin read/delete; create/update go through Cloud
    // Functions that write via Admin SDK (bypasses these rules).
    match /integrations/{integrationId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // ───────────────────────── Subscriptions & billing ─────────────────────────

    match /subscription-plans/{priceId} {
      allow read, list: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Mirrors written only by Stripe webhook Cloud Functions — all client
    // writes denied.
    match /patient-subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Platform (practice-pays-vendor) subscription mirror. Docs:
    //   subscription, config, bonus, usage-{YYYY-MM}
    match /platform/{docId} {
      allow read, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /platform-topups/{topupId} {
      allow read, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Stripe webhook idempotency guard.
    match /platform-stripe-events/{eventId} {
      allow read, list: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
